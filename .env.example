# Runtime
NODE_ENV=development
TRANSACTIONAL_NOTIFICATIONS_ENABLED=false
API_PORT=3001
BOT_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=event_platform_bot
API_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Local infrastructure
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://event_platform:event_platform@localhost:5432/event_platform?schema=public
REDIS_URL=redis://localhost:6379
TABLE_HOLD_TTL_SECONDS=600
TABLE_HOLD_CLEANUP_INTERVAL_SECONDS=60
CHECKOUT_TTL_SECONDS=900
CHECKOUT_CLEANUP_INTERVAL_SECONDS=60

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
BOT_API_SECRET=replace-with-an-internal-32-character-secret
ORGANIZER_REQUIRES_APPROVAL=false

# Local poster adapter (relative to the API process working directory)
POSTER_STORAGE_DIR=var/posters
# Production: use an absolute path backed by a persistent mounted volume.
# WEB_ORIGIN and NEXT_PUBLIC_API_URL must use HTTPS in production.

# Telegram (obtain both values from BotFather)
TELEGRAM_BOT_TOKEN=0000000000:replace-with-real-bot-token
TELEGRAM_BOT_USERNAME=event_platform_bot
# Dedicated Telegram webhook secret (32+ chars; never reuse BOT_API_SECRET)
TELEGRAM_WEBHOOK_SECRET=replace-with-a-separate-32-byte-secret

# Anonymous checkout: verification session 10m; order capability 30d; account claim 10m.
QUICK_SESSION_TTL_SECONDS=600
QUICK_ACCESS_TTL_SECONDS=2592000
QUICK_CLAIM_TTL_SECONDS=600

# Payment provider adapter (provider remains client-selected)
PAYMENT_PROVIDER_NAME=mock
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-a-server-only-webhook-secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# SMS provider adapter (provider remains client-selected)
SMS_PROVIDER_NAME=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# Transactional verification codes and opted-in ticket delivery (Resend).
# Verify the sending domain in Resend first. Store the scoped API key only in
# the ignored .env or a deployment secret store. Without it, email flows are unavailable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=tickets@mail.ticketron.live
# Separate server-only HMAC key for verification proofs and ticket access links.
OTP_HMAC_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# Push provider adapter (provider remains client-selected)
PUSH_PROVIDER_NAME=
PUSH_PROVIDER_API_KEY=
PUSH_PROVIDER_PROJECT_ID=

# Server-only Google Cloud Translation API key. Enable Cloud Translation API;
# organizer translation requests report unavailable until this is configured.
GOOGLE_TRANSLATE_API_KEY=

# Apple Wallet (requires an Apple Developer Pass Type ID and certificates)
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_ORGANIZATION_NAME=
APPLE_WALLET_SIGNER_CERT_PATH=
APPLE_WALLET_SIGNER_KEY_PATH=
APPLE_WALLET_SIGNER_KEY_PASSWORD=
APPLE_WALLET_WWDR_CERT_PATH=
APPLE_WALLET_ICON_PATH=

# Optional: enable Google sign-in with matching web client IDs.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional Google Maps Embed API key. Restrict it to Maps Embed API and your web domains.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=your-browser-restricted-maps-key
