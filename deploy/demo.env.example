# Copy this file to .env.demo at the repository root. Never commit .env.demo.
SITE_DOMAIN=staging.ticketron.live
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-a-different-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-random-hex
BOT_API_SECRET=replace-with-a-different-random-hex
OTP_HMAC_SECRET=replace-with-a-different-random-hex
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-a-different-random-hex
TELEGRAM_WEBHOOK_SECRET=replace-with-a-different-random-hex
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=replace-with-botfather-username
# Enables automatic purchase/event notifications and reminder scheduling.
# Manual delivery actions and other delivery workers are separate.
TRANSACTIONAL_NOTIFICATIONS_ENABLED=true
# Approval-first login: server-only values from BotFather > Login Widget.
# Register https://staging.ticketron.live/login/telegram/callback first.
# Legacy Telegram login remains available while disabled.
TELEGRAM_OIDC_ENABLED=false
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=

# Optional integrations: add these only when the value is available.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=tickets@mail.ticketron.live
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# Optional server-only Azure Translator (create a single-service F0 resource).
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global

# Administration: separate hostname and invitation-only staff accounts.
# Stage: staging-admin.ticketron.live; production: admin.ticketron.live.
ADMIN_DOMAIN=staging-admin.ticketron.live
STAFF_ENABLED=false
# Generate independent values; never reuse JWT/BOT/OTP secrets.
# STAFF_GATEWAY_SECRET=replace-with-independent-64-hex
# STAFF_MFA_ENCRYPTION_KEY=replace-with-independent-64-hex
# Default preserves existing immediate publication. Applies only to NEW events.
EVENT_PUBLICATION_REQUIRES_REVIEW=false
