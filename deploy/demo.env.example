# Copy this file to .env.demo at the repository root. Never commit .env.demo.
SITE_DOMAIN=staging.ticketron.live
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-a-different-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-random-hex
BOT_API_SECRET=replace-with-a-different-random-hex
OTP_HMAC_SECRET=replace-with-a-different-random-hex
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-a-different-random-hex
TELEGRAM_WEBHOOK_SECRET=replace-with-a-different-random-hex
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_BOT_USERNAME=replace-with-botfather-username

# Optional integrations: add these only when the value is available.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=tickets@mail.ticketron.live
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# Optional server-only Azure Translator (create a single-service F0 resource).
TRANSLATION_PROVIDER=azure
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
