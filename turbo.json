{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "API_BASE_URL",
    "API_INTERNAL_URL",
    "API_PORT",
    "APPLE_WALLET_ICON_PATH",
    "APPLE_WALLET_ORGANIZATION_NAME",
    "APPLE_WALLET_PASS_TYPE_ID",
    "APPLE_WALLET_SIGNER_CERT_PATH",
    "APPLE_WALLET_SIGNER_KEY_PASSWORD",
    "APPLE_WALLET_SIGNER_KEY_PATH",
    "APPLE_WALLET_TEAM_ID",
    "APPLE_WALLET_WWDR_CERT_PATH",
    "BOT_API_SECRET",
    "BOT_INTERNAL_URL",
    "BOT_PORT",
    "DATABASE_URL",
    "GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_TELEGRAM_BOT_USERNAME",
    "NODE_ENV",
    "ORGANIZER_REQUIRES_APPROVAL",
    "EVENT_CONTENT_V2_ENABLED",
    "POSTER_STORAGE_DIR",
    "REDIS_URL",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_BOT_USERNAME",
    "TABLE_HOLD_CLEANUP_INTERVAL_SECONDS",
    "TABLE_HOLD_TTL_SECONDS",
    "WEB_ORIGIN",
    "DRAFT_MEDIA_STORAGE_DIR",
    "MEDIA_FFMPEG_PATH",
    "MEDIA_FFPROBE_PATH",
    "MEDIA_IMAGE_MAX_BYTES",
    "MEDIA_VIDEO_MAX_BYTES",
    "MEDIA_VIDEO_MAX_SECONDS",
    "MEDIA_DRAFT_MAX_BYTES",
    "GOOGLE_TRANSLATE_API_KEY",
    "TRANSLATION_PROVIDER",
    "AZURE_TRANSLATOR_KEY",
    "AZURE_TRANSLATOR_REGION",
    "TRANSLATION_TIMEOUT_MS",
    "TRANSLATION_RETRIES",
    "TRANSLATION_HOURLY_REQUESTS",
    "TRANSLATION_DAILY_CHARACTERS",
    "TRANSLATION_CACHE_SECONDS",
    "TICKET_NEXT_DIST_DIR",
    "GOOGLE_AUTH_DB_TEST",
    "EVENT_CREATION_DB_TEST",
    "VERIFICATION_TEST_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
